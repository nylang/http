  if n == 3 || n == 4 || n == 6 || n == 7 { framing=framing.Concat("Expect: 100-continue\r\n"); }
  let wire: string = "POST /upload HTTP/1.1\r\nHost: localhost:".Concat(authority).Concat("\r\n").Concat(framing).Concat("\r\n");
  let head: NetBuffer = (NetBuffer.CopyFrom(NetBytes.FromString(wire)).get_if<NetBuffer>()) as NetBuffer;
  var made: Result<HttpClientExchange,HttpError> = HttpClientExchange.NewStreaming(head,HttpClientLimits{max_retained_request_bytes:1024});
  if made.IsErr() { return 1; } var exchange: HttpClientExchange = move((made.get_if<HttpClientExchange>()) as HttpClientExchange);
  var opened: Result<TcpConnection,NetError> = TcpConnection.Dial(endpoint,options); if opened.IsErr() { return 2; }
  var connection: TcpConnection = move((opened.get_if<TcpConnection>()) as TcpConnection);
  @@OPEN@@
  if !send_ready(exchange,io,options) { return 3; }
  if n == 8 { if !await_checkpoint(exchange,io,options) { return 24; } token.Cancel(); if options.Check(NetClock.NowNanoseconds()).IsOk() || exchange.Stats().request_bytes_sent!=wire.length as uint64 { return 4; } @@ABORT@@ return 0; }
  var produced: int32 = 0; var complete: bool = false; var status: int32 = 0; var reads: bool = false; var rounds: int32 = 0;
  var text: StringBuffer = StringBuffer.New(); var held: NetBuffer = NetBuffer{}; var released: bool = false;
  while !complete && rounds < 10000 {
    rounds=rounds+1; if options.Check(NetClock.NowNanoseconds()).IsErr() { return 5; }
    let queried: Result<HttpUploadState,HttpError> = exchange.UploadState(); if queried.IsErr() { return 6; }
    let state: HttpUploadState = (queried.get_if<HttpUploadState>()) as HttpUploadState;
    if state==HttpUploadState.WaitingContinue {
