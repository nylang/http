          var payload: string = "abc"; if produced==1 { payload="def"; }
          let block: NetBuffer = (NetBuffer.CopyFrom(NetBytes.FromString(payload)).get_if<NetBuffer>()) as NetBuffer;
          if exchange.SupplyBody(block).IsErr() { return 9; } produced=produced+1;
          if n==5 && produced==2 { held=(exchange.Output().get_if<NetBuffer>()) as NetBuffer; reads=true; continue; }
        } else {
          var trailers: owned <HttpField>[] = new <HttpField>[0]; if n==2 { trailers=new <HttpField>[]{HttpField{name:"X-End",value:"yes"}}; }
          if exchange.FinishBody(trailers).IsErr() { return 10; }
        }
      }
      if !send_ready(exchange,io,options) { return 11; } continue;
    }
    let next: Result<HttpClientEvent,HttpError> = exchange.NextResponse(); if next.IsErr() { return 12; }
    let event: HttpClientEvent = (next.get_if<HttpClientEvent>()) as HttpClientEvent;
    if event.kind==HttpClientEventKind.NeedInput { if !receive_once(exchange,io,options) { return 13; } continue; }
    if event.kind==HttpClientEventKind.Informational { if event.head.Status()==100 && n!=7 { reads=false; } }
    if event.kind==HttpClientEventKind.Head { status=event.head.Status(); reads=true; }
