          let end: Result<Unit,HttpError> = exchange.FinishBody(new <HttpField>[0]);
          if end.IsOk() || ((end.get_if<HttpError>()) as HttpError).kind!=HttpErrorKind.UnexpectedEof || exchange.Stats().request_bytes_sent!=wire.length as uint64+3u64 { return 8; }
          @@ABORT@@ return 0;
        }
