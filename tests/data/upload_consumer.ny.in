  var content: string = "ok"; if early { content="no"; }
  if !complete || status!=expected || !text.Take().Equal(content) || exchange.RequestComplete()==early { return 14; }
  var bytes: uint64 = 6u64; if n==2 { bytes=33u64; } if n==4 || n==7 { bytes=0u64; } if n==5 { bytes=3u64; }
  if exchange.Stats().request_bytes_sent!=wire.length as uint64+bytes { return 15; }
  if n==5 && held.Len()!=(3 as intptr) { return 16; }
