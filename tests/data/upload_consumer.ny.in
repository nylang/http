@@HELPERS@@
func send_ready(exchange: ref mut HttpClientExchange, io: ref mut @@IO@@, options: ref NetOperationOptions) -> bool {
  var rounds: int32 = 0;
  while rounds < 10000 {
    let output: Result<NetBuffer,HttpError> = exchange.Output(); if output.IsErr() { return false; }
    let block: NetBuffer = (output.get_if<NetBuffer>()) as NetBuffer; if block.Len()==(0 as intptr) { return true; }
    @@WRITE@@
    if count <= (0 as intptr) || exchange.AcknowledgeOutput(count).IsErr() { return false; }
    rounds = rounds+1;
  }
  return false;
}
func receive_once(exchange: ref mut HttpClientExchange, io: ref mut @@IO@@, options: ref NetOperationOptions) -> bool {
  @@READ@@
}
func await_checkpoint(exchange: ref mut HttpClientExchange, io: ref mut @@IO@@, options: ref NetOperationOptions) -> bool {
  var rounds: int32 = 0;
  while rounds < 1000 {
    let next: Result<HttpClientEvent,HttpError> = exchange.NextResponse(); if next.IsErr() { return false; }
    let event: HttpClientEvent = (next.get_if<HttpClientEvent>()) as HttpClientEvent;
    if event.kind==HttpClientEventKind.NeedInput { if !receive_once(exchange,io,options) { return false; } }
    else { return event.kind==HttpClientEventKind.Informational && event.head.Status()==103; }
    rounds=rounds+1;
  }
  return false;
}
func main() -> int32 {
  let n: int32 = HttpFixtureCase(); let port: int32 = HttpFixturePort();
  var token: NetCancellation = NetCancellation.New();
  let options: NetOperationOptions = NetOperationOptions{cancellation:token,deadline:NetDeadline.After(NetClock.NowNanoseconds(),8000000000u64)};
  let endpoint: NetEndpoint = (NetEndpoint.New(IpAddress.V4(127u8,0u8,0u8,1u8),port).get_if<NetEndpoint>()) as NetEndpoint;
  let authority: string = endpoint.ToString().Substring(10,endpoint.ToString().length-10);
  var framing: string = "Content-Length: 6\r\n";
