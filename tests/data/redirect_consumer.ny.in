/** @brief External explicit redirect chain over ordinary TCP or verified HTTPS. */
import "stdlib:stdlib.ny";
import "net_core:net_core.ny";
import "http:http.ny";
@@TLS_IMPORTS@@
@extern("C") func HttpFixturePort() -> int32;
@extern("C") func HttpFixtureCase() -> int32;
@extern("C") func HttpFixtureCa() -> *const int8;
@extern("C") func HttpFixtureCaLength() -> int32;
func main() -> int32 {
  let n: int32 = HttpFixtureCase();
  let endpoint: NetEndpoint = (NetEndpoint.New(IpAddress.V4(127u8,0u8,0u8,1u8),HttpFixturePort()).get_if<NetEndpoint>()) as NetEndpoint;
  let port: string = endpoint.ToString().Substring(10,endpoint.ToString().length-10);
  let url: HttpUrl = (HttpUrl.Parse("@@SCHEME@@://localhost:".Concat(port).Concat("/dir/start")).get_if<HttpUrl>()) as HttpUrl;
  var policy: HttpRedirectPolicy = HttpRedirectPolicy{};
  if n == 2 { policy.allow_unsafe_replay = true; }
  if n == 4 || n == 13 { policy.allow_cross_origin = true; }
  if n == 6 { policy.max_redirects = 2; }
  var fields: owned <HttpField>[] = new <HttpField>[]{HttpField{name:"Authorization",value:"Bearer secret"},HttpField{name:"Cookie",value:"sid=secret"},HttpField{name:"X-Secret",value:"secret"},HttpField{name:"Accept",value:"text/plain"},HttpField{name:"Content-Type",value:"text/plain"},HttpField{name:"Connection",value:"X-Hop"},HttpField{name:"X-Hop",value:"remove"}};
  var verb: string = "POST"; var payload: string = "abc";
  if n == 4 || n == 5 || n == 6 || n == 13 { verb = "GET"; payload = ""; }
  let body: NetBuffer = (NetBuffer.CopyFrom(NetBytes.FromString(payload)).get_if<NetBuffer>()) as NetBuffer;
  var token: NetCancellation = NetCancellation.New(); var options: NetOperationOptions = NetOperationOptions{cancellation:token,deadline:NetDeadline.After(NetClock.NowNanoseconds(),8000000000u64)};
  if n == 11 { options.deadline = NetDeadline.After(NetClock.NowNanoseconds(),1000000000u64); }
  var made: Result<HttpRedirectChain,HttpClientError> = HttpRedirectChain.New(url,verb,fields,body,HttpClientLimits{},policy,options);
  if made.IsErr() { return 1; } var chain: HttpRedirectChain = move((made.get_if<HttpRedirectChain>()) as HttpRedirectChain);
  var pool: Result<AsyncResolver,NetError> = AsyncResolver.New(1,2); if pool.IsErr() { return 2; }
  var resolver: AsyncResolver = move((pool.get_if<AsyncResolver>()) as AsyncResolver);
  @@CONFIG@@
  var requests: int32 = 0;
  while requests < 5 {
    let next: Result<HttpRedirectRequest,HttpClientError> = chain.Request(); if next.IsErr() { return 3; }
    let request: HttpRedirectRequest = (next.get_if<HttpRedirectRequest>()) as HttpRedirectRequest;
    var opened: Result<@@CLIENT@@,@@ERROR@@> = @@OPEN@@;
    if opened.IsErr() { Console.Eprintln("redirect snapshot open failed"); return 4; }
    var client: @@CLIENT@@ = move((opened.get_if<@@CLIENT@@>()) as @@CLIENT@@); requests = requests+1;
    var redirected: bool = false; var content: StringBuffer = StringBuffer.New(); var status: int32 = 0; var events: int32 = 0; var complete: bool = false;
    while events < 1000 {
      let advanced: Result<HttpClientEvent,@@ERROR@@> = client.Next(); if advanced.IsErr() { Console.Eprintln("redirect response read failed"); return 5; }
      let event: HttpClientEvent = (advanced.get_if<HttpClientEvent>()) as HttpClientEvent; events = events+1;
      if event.kind == HttpClientEventKind.Head {
        status = event.head.Status(); if n == 8 { token.Cancel(); } if n == 11 { Thread.Sleep(1100u32); }
        let decision: Result<bool,HttpClientError> = chain.Follow(event.head);
        if decision.IsErr() {
          client.Close(); let error: HttpClientError = (decision.get_if<HttpClientError>()) as HttpClientError;
          if chain.Request().IsOk() { return 6; }
          if n == 8 || n == 11 {
            if error.transport_error == nil { return 7; } var expected: NetErrorKind = NetErrorKind.Cancelled; if n == 11 { expected = NetErrorKind.TimedOut; }
            if (error.transport_error as NetError).kind != expected || chain.Count() != 0 { return 8; } return 0;
          }
          if error.protocol_error == nil { return 9; } let kind: HttpErrorKind = (error.protocol_error as HttpError).kind;
          if n == 3 && kind == HttpErrorKind.ReplayRejected { return 0; }
          if n == 5 && kind == HttpErrorKind.CrossOriginRedirect { return 0; }
          if n == 6 && kind == HttpErrorKind.RedirectLimit && requests == 3 && chain.Count() == 2 { return 0; }
          if n == 7 && kind == HttpErrorKind.InvalidFraming { return 0; }
          if n == 10 && kind == HttpErrorKind.Malformed { return 0; }
          if n == 13 && kind == HttpErrorKind.InsecureRedirect { return 0; }
          Console.Eprintln("unexpected redirect policy error"); return 10;
        }
        if (decision.get_if<bool>()) as bool { client.Close(); redirected = true; break; }
      }
      if event.kind == HttpClientEventKind.Body { content.Append(string.ViewFrom(event.buffer.Bytes().Data() as *const int8,event.buffer.Len() as int32)); }
      if event.complete { complete = true; break; }
    }
    if redirected { continue; }
    if !complete || !content.Take().Equal("hello") { return 11; }
    if n == 12 { if status != 302 || requests != 1 || chain.Count() != 0 { return 12; } }
    else { if status != 200 || requests != 2 || chain.Count() != 1 { return 13; } }
    @@SHUTDOWN@@
    client.Close(); return 0;
  }
  return 14;
}
