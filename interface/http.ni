/** @brief Bounded HTTP/1.x framing shared by plain TCP and verified TLS consumers. */
import "stdlib:stdlib.ny";
import "net_core:net_core.ny";

/** @brief Protocol/limit failures; no socket or provider error is hidden here. */
pub enum HttpErrorKind { InvalidArgument, InvalidState, Closed, Malformed, LimitExceeded, InvalidFraming, Unsupported, UnexpectedEof, ResourceExhausted, RedirectLimit, InsecureRedirect, CrossOriginRedirect, ReplayRejected }
/** @brief offset counts wire bytes consumed/generated by this protocol cursor at detection, not a source span. */
pub struct HttpError { kind: HttpErrorKind; offset: int64; }
/** @brief Zero values select 32768 head bytes, 8192 bytes per line and 100 fields. */
pub struct HttpHeadLimits { max_head_bytes: int32; max_line_bytes: int32; max_fields: int32; }
/** @brief Ordered field; duplicate ordinary fields are preserved without comma merging. */
pub struct HttpField { name: string; value: string; }
/** @brief Validated message framing, independent of socket and TLS ownership. */
pub enum HttpBodyKind { None, ContentLength, Chunked, UntilEof, Upgrade, Tunnel }
/** @brief length applies only to ContentLength; close_connection forbids connection reuse. */
pub struct HttpBodyPlan { kind: HttpBodyKind; length: uint64; close_connection: bool; }
/** @brief Immutable, copyable head owning every returned string through shared storage. */
pub struct HttpHead;
/** @brief Whether this is a response; a default head is invalid. */
pub method(HttpHead) IsResponse() -> bool;
/** @brief HTTP minor version (0/1), or -1 for a default head. */
pub method(HttpHead) MinorVersion() -> int32;
/** @brief Request method, or empty for a response/default head; owned result. */
pub method(HttpHead) Method() -> string;
/** @brief Request target, or empty for a response/default head; owned result. */
pub method(HttpHead) Target() -> string;
/** @brief Response status (100..599), or zero for a request/default head. */
pub method(HttpHead) Status() -> int32;
/** @brief Response reason bytes, possibly empty; owned result. */
pub method(HttpHead) Reason() -> string;
/** @brief Number of ordered header fields; zero for a default head. */
pub method(HttpHead) FieldCount() -> int32;
/** @brief Return an owned field or InvalidArgument for an out-of-range index. */
pub method(HttpHead) FieldAt(index: int32) -> Result<HttpField, HttpError>;
/** @brief Validated body framing, or InvalidState for a default head. */
pub method(HttpHead) BodyPlan() -> Result<HttpBodyPlan, HttpError>;
/** @brief Move-only, single-caller incremental head parser; input is borrowed only during Push. */
pub struct HttpHeadParser;
/** @brief Parser state cannot be implicitly duplicated. */
pub method(HttpHeadParser) operator copy() -> HttpHeadParser = delete;
/** @brief Transfer parser ownership and invalidate the source. */
pub method(HttpHeadParser) operator move() -> HttpHeadParser;
/** @brief Release parser storage through language ownership. */
pub method(HttpHeadParser) operator drop() -> void;
/** @brief Construct a strict origin-form/OPTIONS-* request parser; caps: 1 MiB/64 KiB/128 fields. */
pub static method(HttpHeadParser) NewRequest(limits: ref HttpHeadLimits) -> Result<HttpHeadParser, HttpError>;
/** @brief Construct a response parser with case-sensitive originating method (HEAD/CONNECT semantics). */
pub static method(HttpHeadParser) NewResponse(request_method: ref string, limits: ref HttpHeadLimits) -> Result<HttpHeadParser, HttpError>;
/**
 * @brief Consume through CRLFCRLF only; success returns the exact consumed input prefix.
 * @note Stops before body/pipeline/tunnel bytes. Complete parsers consume zero. Errors are sticky;
 *       discard the connection on error, not just this input span. Limits include head CRLF bytes.
 */
pub method(HttpHeadParser) Push(bytes: ref NetBytes) -> Result<intptr, HttpError>;
/** @brief Whether a complete, validated head is available. */
pub method(HttpHeadParser) IsComplete() -> bool;
/** @brief Owned immutable head, pending InvalidState, or the sticky terminal error. */
pub method(HttpHeadParser) Head() -> Result<HttpHead, HttpError>;
/** @brief Return a complete head or mark incomplete transport EOF as terminal UnexpectedEof. */
pub method(HttpHeadParser) EndInput() -> Result<HttpHead, HttpError>;
/** @brief HTTP/1.1 head serialization with the same strict parser validation and default limits. */
pub struct HttpWriter { }
/** @brief Validate method, origin-form/OPTIONS-* target and fields; mandatory single Host. No body emitted. */
pub static method(HttpWriter) Request(verb: ref string, target: ref string, fields: ref <HttpField>[]) -> Result<NetBuffer, HttpError>;
/** @brief Validate status/reason/fields with originating-method framing; no body emitted. */
pub static method(HttpWriter) Response(status: int32, reason: ref string, fields: ref <HttpField>[], request_method: ref string) -> Result<NetBuffer, HttpError>;

/** @brief Zero selects 16 MiB decoded bytes, 1 MiB cumulative framing bytes, 8192 line bytes and 100 trailers.
 * @note Hard caps: decoded 9223372036837998591 bytes, framing 16 MiB, line 64 KiB, trailers 128.
 *       Framing includes chunk-size lines, data CRLF and trailer lines. No payload-sized allocation.
 */
pub struct HttpBodyLimits { max_body_bytes: uint64; max_framing_bytes: int32; max_line_bytes: int32; max_trailers: int32; }
/** @brief Progress requests another call; NeedInput/NeedOutput describe the next required resource. */
pub enum HttpBodyState { Progress, NeedInput, NeedOutput, Complete }
/** @brief Exact borrowed input consumed and caller output initialized during this call. */
pub struct HttpBodyProgress { consumed: intptr; produced: intptr; state: HttpBodyState; }
/** @brief Move-only single-caller body decoder. Neither input nor output pointers survive Push. */
pub struct HttpBodyDecoder;
/** @brief Incremental body cursors cannot be copied. */
pub method(HttpBodyDecoder) operator copy() -> HttpBodyDecoder = delete;
/** @brief Transfer cursor ownership, invalidating the source. */
pub method(HttpBodyDecoder) operator move() -> HttpBodyDecoder;
/** @brief Release owned metadata and scratch storage. */
pub method(HttpBodyDecoder) operator drop() -> void;
/** @brief Build from a validated head; reject Upgrade/Tunnel as Unsupported and oversized fixed bodies immediately. */
pub static method(HttpBodyDecoder) New(head: ref HttpHead, limits: ref HttpBodyLimits) -> Result<HttpBodyDecoder, HttpError>;
/** @brief Decode at most one contiguous payload span per call, stopping exactly at the message boundary.
 * @note Input/output ranges must not overlap. Output may be empty: metadata can advance until payload
 *       needs space. An error initializes no output bytes in that call, is sticky, and requires discarding
 *       the connection. Earlier successful output is partial until Complete. No decompression occurs.
 */
pub method(HttpBodyDecoder) Push(bytes: ref NetBytes, output: ref NetMutableBytes) -> Result<HttpBodyProgress, HttpError>;
/** @brief Complete close-delimited bodies; other incomplete framing becomes sticky UnexpectedEof. */
pub method(HttpBodyDecoder) EndInput() -> Result<bool, HttpError>;
/** @brief Whether all framing including trailers has completed successfully. */
pub method(HttpBodyDecoder) IsComplete() -> bool;
/** @brief Completed trailer count, or pending InvalidState/terminal error. Fields never merge into the head. */
pub method(HttpBodyDecoder) TrailerCount() -> Result<int32, HttpError>;
/** @brief Owned ordered trailer field after completion; invalid index returns InvalidArgument.
 * @note Known framing, routing, connection/control, authentication and representation fields are rejected.
 *       Unknown fields remain untrusted application metadata; apply field-specific semantics explicitly.
 */
pub method(HttpBodyDecoder) TrailerAt(index: int32) -> Result<HttpField, HttpError>;

/** @brief Move-only streaming body encoder using caller-owned output, with no retained payload pointer. */
pub struct HttpBodyWriter;
/** @brief Incremental output cursors cannot be copied. */
pub method(HttpBodyWriter) operator copy() -> HttpBodyWriter = delete;
/** @brief Transfer pending framing and payload progress, invalidating the source. */
pub method(HttpBodyWriter) operator move() -> HttpBodyWriter;
/** @brief Drop bounded framing metadata; previously generated output remains caller-owned. */
pub method(HttpBodyWriter) operator drop() -> void;
/** @brief Build from a validated head and body limits; reject Upgrade/Tunnel and oversized fixed lengths.
 * @note Trailer declarations must contain safe token names and require chunked framing.
 */
pub static method(HttpBodyWriter) New(head: ref HttpHead, limits: ref HttpBodyLimits) -> Result<HttpBodyWriter, HttpError>;
/** @brief Encode one framing or payload span, reporting exact accepted payload and generated wire bytes.
 * @note Input/output must not overlap. Retain the unconsumed payload suffix across calls; metadata may
 *       produce output with zero input consumed. No borrowed pointer survives the call. Offer only this
 *       body's bytes: excess fixed-length/no-body input is an error, not a next-message handoff.
 *       Errors are sticky, write no output in that call, and require discarding the connection.
 *       Generated output must be fully sent before generating more; transport acceptance is separate.
 */
pub method(HttpBodyWriter) Push(bytes: ref NetBytes, output: ref NetMutableBytes) -> Result<HttpBodyProgress, HttpError>;
/** @brief Close input and queue bounded chunk trailers; return whether all output is already generated.
 * @note Fixed/chunk-announced payload shortage is terminal UnexpectedEof. Trailers require chunked
 *       framing, safe fields and matching Trailer declarations. Repeat only with an empty trailer list.
 *       Drain pending framing with Push(empty, output) until Complete. After UntilEof output drains,
 *       the caller must close the transport to delimit the message. No transport operation occurs here.
 */
pub method(HttpBodyWriter) Finish(trailers: ref <HttpField>[]) -> Result<bool, HttpError>;
/** @brief Whether all wire bytes have been generated; this does not confirm transport delivery. */
pub method(HttpBodyWriter) IsComplete() -> bool;

/** @brief Per-head limits plus aggregate response-head limits; zero selects 16 informational heads and 1 MiB total.
 * @note Hard caps: 64 informational heads and 16 MiB total, including the final head and all CRLF bytes.
 */
pub struct HttpResponseLimits { head: HttpHeadLimits; max_informational: int32; max_total_head_bytes: int32; }
/** @brief A completed informational event, terminal final/101 event, or an incomplete head needing input. */
pub enum HttpResponseState { NeedInput, Informational, Final }
/** @brief Exact consumed input prefix through at most one response head. */
pub struct HttpResponseProgress { consumed: intptr; state: HttpResponseState; }
/** @brief Move-only parser for one request's informational heads and final response, without body decoding. */
pub struct HttpResponseParser;
/** @brief Response association cursors cannot be copied. */
pub method(HttpResponseParser) operator copy() -> HttpResponseParser = delete;
/** @brief Transfer the originating request context and incremental head cursor. */
pub method(HttpResponseParser) operator move() -> HttpResponseParser;
/** @brief Release the cursor; previously returned owned heads remain valid. */
pub method(HttpResponseParser) operator drop() -> void;
/** @brief Retain the case-sensitive originating method for every informational/final head. */
pub static method(HttpResponseParser) New(request_method: ref string, limits: ref HttpResponseLimits) -> Result<HttpResponseParser, HttpError>;
/** @brief Stop at each response head; 100..199 except 101 are informational, 101 is a terminal handoff.
 * @note After Informational, retain Head() before feeding the next nonempty input. Final consumes no
 *       body/pipeline/tunnel bytes, and later Push calls consume zero. Errors are sticky with aggregate
 *       sequence offsets; discard the connection. No upgrade negotiation or request queue is implemented.
 */
pub method(HttpResponseParser) Push(bytes: ref NetBytes) -> Result<HttpResponseProgress, HttpError>;
/** @brief Last completed event head; pending InvalidState, closed cursor or terminal error otherwise. */
pub method(HttpResponseParser) Head() -> Result<HttpHead, HttpError>;
/** @brief Whether a final response or 101 handoff head has completed successfully. */
pub method(HttpResponseParser) IsComplete() -> bool;
/** @brief Accepted informational head count, excluding 101; zero for a default cursor. */
pub method(HttpResponseParser) InformationalCount() -> int32;
/** @brief Return the terminal head, or make EOF before a final/101 head a sticky UnexpectedEof. */
pub method(HttpResponseParser) EndInput() -> Result<HttpHead, HttpError>;
